# Backend Environment Configuration
# Copy this file to `.env` in the backend folder and fill in your values.

# Server Port
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=lintara

# JWT Secret (IMPORTANT: Generate a secure random string)
# You can generate this with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=intara-local-development-secret

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:8081,http://192.168.1.32:5000

# Google OAuth (optional, for Google login)
# Get these from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Additional Optional Configuration
NODE_ENV=development
LOG_LEVEL=info
