{
  "expo": {
    "name": "Lintara",
    "slug": "lintara",
    "owner": "dzulkar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lintara",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dzulkar.lintara",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dzulkar.lintara",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Lintara.png",
        "backgroundColor": "#E6F4FE"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Lintara.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0bb2175-7e5b-4734-9012-26f5fd1e7989"
      },
      "EXPO_PUBLIC_GOOGLE_REDIRECT_URI": "lintara://redirect"
    }
  }
}
